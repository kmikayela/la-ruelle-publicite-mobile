FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=false

# Timezone used for business-hours detection.
BUSINESS_TIMEZONE=Europe/Paris
BUSINESS_DAYS=0,1,2,3,4
BUSINESS_START=09:00
BUSINESS_END=18:00

# Delay before the bot answers during business hours if no human reply is seen.
HUMAN_REPLY_TIMEOUT_SECONDS=300

# BSP API settings. Keep BSP_PROVIDER=mock for local tests with ngrok.
BSP_PROVIDER=mock
BSP_BASE_URL=https://api.respond.io
BSP_TOKEN=replace_me
BSP_CHANNEL_ID=replace_me

# WhatsApp compliance.
WHATSAPP_SESSION_HOURS=24
FOLLOWUP_TEMPLATE_NAME=customer_followup_fr
FOLLOWUP_TEMPLATE_LANGUAGE=fr

AUTO_REPLY_AFTER_HOURS=Bonjour, merci pour votre message. Nous sommes actuellement fermes. Nous vous repondrons des notre retour aux horaires d'ouverture.
AUTO_REPLY_ABSENT=Bonjour, merci pour votre message. Nous sommes momentanement indisponibles. Nous revenons vers vous des que possible.
AUTO_REPLY_TIMEOUT=Bonjour, merci pour votre patience. Nous avons bien recu votre message et revenons vers vous rapidement.
